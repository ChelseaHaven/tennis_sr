#!/usr/bin/env python3
"""Launch RViz with the local empty-XRandR-mode compatibility guard."""
import os
from pathlib import Path
import sys
from ament_index_python.packages import get_package_prefix

prefix = Path(get_package_prefix('fast_fly_ros2'))
guard = prefix / 'lib/libmecanum_x11_guard.so'
env = os.environ.copy()
if env.get('MECANUM_X11_GUARD', '1') != '0':
    env['LD_PRELOAD'] = str(guard) + (':' + env['LD_PRELOAD'] if env.get('LD_PRELOAD') else '')
rviz = Path(get_package_prefix('rviz2')) / 'lib/rviz2/rviz2'
os.execve(str(rviz), [str(rviz), *sys.argv[1:]], env)
